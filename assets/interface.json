{
    "interface_version": 2,
    "name": "M7A",
    "description": "游戏自动登录工具",
    "contact": "QQ：863308328",
    "license": "MIT",
    "welcome": "欢迎使用 M7A!",
    "github": "https://github.com/MaaXYZ/MaaPracticeBoilerplate",
    "version": "1.0.0",

    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 1080
        }
    ],

    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "./resource",
                "./resource_bilibili"
            ]
        }
    ],

    "agent": {
        "child_exec": "python",
        "child_args": [
            "../agent/main.py"
        ]
    },

    "task": [
        {
            "name": "开启游戏",
            "entry": "StartUp"
        },
        {
            "name": "夏日-幸运冲刺",
            "entry": "SummerLuckySprint"
        },
        {
            "name": "友情点弹窗测试",
            "entry": "TestFriendPoints"
        }
    ]
}

{
    // ============================================================
    // 游戏自动登录流程
    // ============================================================
    // 流程概述：
    //   1. 等待游戏加载完成，识别公告弹窗
    //   2. 关闭公告弹窗（点击 X 按钮）
    //   3. 等待"同意协议"勾选框出现
    //   4. 点击屏幕正中间，完成登录
    // ============================================================

    // 阶段1: 等待公告弹窗出现
    // 游戏启动后，屏幕上会显示公告弹窗，持续等待直到识别到公告图片
    "WaitAnnouncement": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "login/LoginAnnouncement.png"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "CloseAnnouncement"
        ],
        "timeout": 120000,
        "timeout_next": [
            "CloseAnnouncement"
        ]
    },

    // 阶段2: 点击关闭按钮，关闭公告
    // 识别公告上的关闭按钮（X 图标）并点击
    "CloseAnnouncement": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "login/LoginCancel.png"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_delay": 2000,
        "next": [
            "WaitAgreement"
        ]
    },

    // 阶段3: 等待"同意协议"勾选框
    // 公告关闭后，等待界面加载出"用户同意协议"的勾选标志
    "WaitAgreement": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "login/AgreementCheckbox.png"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "ClickScreenCenter"
        ],
        "timeout": 60000,
        "timeout_next": [
            "ClickScreenCenter"
        ]
    },

    // 阶段4: 点击屏幕正中间完成登录
    // 勾选协议后，点击屏幕正中间位置触发登录
    // 使用自定义动作 click_screen_center，通过控制器获取实际分辨率后计算中心点
    "ClickScreenCenter": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "click_screen_center",
                "custom_action_param": {
                    "offset_x": 0,
                    "offset_y": 0,
                    "post_delay": 1000
                }
            }
        }
    }
}

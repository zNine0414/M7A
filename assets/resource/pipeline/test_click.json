{
    // ============================================================
    // 点击功能测试
    // 重复点击屏幕正中间，直到"用户协议隐私保护勾"从屏幕上消失
    // 用于验证触控坐标系与截图坐标系是否一致
    // ============================================================

    "TestClickCenter": {
        "action": "DoNothing",
        "next": [
            "ClickCenter",
            "CheckAgreementGone"
        ]
    },

    "ClickCenter": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "click_screen_center",
                "custom_action_param": {
                    "offset_x": 0,
                    "offset_y": 0,
                    "post_delay": 500
                }
            }
        },
        "post_delay": 1000,
        "next": [
            "CheckAgreementGone"
        ]
    },

    "CheckAgreementGone": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "login/AgreementCheckbox.png"
                ]
            }
        },
        "action": "DoNothing",
        "next": [
            "ClickCenter"
        ],
        "timeout": 1500,
        "on_error": [
            "TestPassed"
        ],
        "max_hit": 20
    },

    "TestPassed": {
        "action": "DoNothing",
        "focus": {
            "Node.Action.Starting": "<span style=\"color:green;\">测试通过：点击功能正常，已成功消除协议弹窗</span>"
        }
    }
}
